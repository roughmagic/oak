{
  "name": "@roughmagic/oak-react",
  "version": "0.1.1",
  "description": "React bindings for Oak.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roughmagic/oak.git",
    "directory": "packages/oak-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "tsc -p test && vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "peerDependencies": {
    "@roughmagic/oak": "workspace:^",
    "effect": "^3.22.2",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@roughmagic/oak": "workspace:^",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
