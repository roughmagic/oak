{
  "name": "@roughmagic/oak",
  "version": "0.1.1",
  "description": "The Elm Architecture for TypeScript, built on Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roughmagic/oak.git",
    "directory": "packages/oak"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "tsc -p test && vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "peerDependencies": {
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
